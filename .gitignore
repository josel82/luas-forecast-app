# EXCLUDE IMAGE DIRECTORIES (as they contain only images)
/static/images/
/forecast/static/images/


# EXCLUDE the GENERATED collectstatic folder 
# You must change STATIC_ROOT in settings.py to a different name, e.g., 'staticfiles_collected'
/staticfiles_collected/

